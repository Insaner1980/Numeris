<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Numeris.Controls"
    xmlns:models="using:Numeris.Models">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          Padding="{StaticResource PagePadding}"
          RowSpacing="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Vertical" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Horizontal" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Right" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Left" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorderStyle}">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="HeaderGrid" Grid.Row="0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Performance"
                               Style="{StaticResource PageTitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="HeaderControls"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <ComboBox x:Name="DomainCombo"
                                  MinWidth="176"
                                  Height="{StaticResource ToolbarControlHeight}"
                                  Style="{StaticResource DomainComboBoxStyle}"
                                  AutomationProperties.Name="Domain"
                                  IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                  SelectionChanged="DomainCombo_SelectionChanged" />
                        <Grid x:Name="ToolbarActionRow"
                              ColumnSpacing="8"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ToolbarPeriodColumn" Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:PeriodSelector x:Name="PeriodSelector"
                                                     Grid.Column="0"
                                                     SelectedPeriod="{x:Bind Shell.SelectedPeriod, Mode=OneWay}"
                                                     AutomationProperties.Name="Period"
                                                     IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                                     SelectionChanged="PeriodSelector_SelectionChanged" />
                            <Button x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ToolbarRefreshButtonStyle}"
                                    Click="RefreshButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                    AutomationProperties.Name="Refresh current report"
                                    ToolTipService.ToolTip="Refresh" />
                        </Grid>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Width="20" Height="20"
                                      AutomationProperties.Name="Loading selected report"
                                      ToolTipService.ToolTip="Loading selected report; previously loaded data is still shown." />
                    </StackPanel>
                </Grid>

                <SelectorBar Grid.Row="1"
                             x:Name="TabBar"
                             Style="{StaticResource TopTabSelectorBarStyle}"
                             SelectionChanged="TabBar_SelectionChanged">
                    <SelectorBarItem Tag="overview" Text="Overview" />
                    <SelectorBarItem Tag="crux" Text="CrUX" />
                    <SelectorBarItem Tag="pagespeed" Text="PageSpeed" />
                    <SelectorBarItem Tag="urls" Text="URLs" />
                </SelectorBar>
                <InfoBar Grid.Row="2"
                         IsOpen="{x:Bind ViewModel.HasRefreshStatusMessage, Mode=OneWay}"
                         Message="{x:Bind ViewModel.RefreshStatusMessage, Mode=OneWay}"
                         Severity="{x:Bind ViewModel.RefreshSeverity, Mode=OneWay}"
                         IsClosable="False"
                         Style="{StaticResource StatusInfoBarStyle}"
                         AutomationProperties.Name="Performance refresh status" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="PageScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="PageScrollViewer_SizeChanged">
        <Grid x:Name="ReportContent" MinHeight="{StaticResource ReportHeroMinHeight}"
              MinWidth="{StaticResource ReportDataMinWidth}"
              Width="{Binding ViewportWidth, ElementName=PageScrollViewer}">
            <Grid x:Name="OverviewPanel" Visibility="Visible" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Core Web Vitals" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.WebVitalsStatus, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.WebVitalsDetail, Mode=OneWay}" Foreground="{StaticResource NumerisTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="PageSpeed mobile" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.MobileScoreText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="PageSpeed desktop" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.DesktopScoreText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.CoreVitals, Mode=OneWay}"
                          Style="{StaticResource DataListViewStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CruxMetricSummary">
                            <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Target}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                    <TextBlock TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" Foreground="{StaticResource NumerisTextTertiaryBrush}">
                                        <Run Text="Collected through " />
                                        <Run Text="{x:Bind LatestCollectionEnd}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind FormFactor}" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Metric}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind P75Text}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Status}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="CruxPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="MetricCombo" Width="240" AutomationProperties.Name="CrUX metric" SelectionChanged="MetricCombo_SelectionChanged" />
                    <ComboBox x:Name="FormFactorCombo" Width="140" AutomationProperties.Name="CrUX form factor" SelectionChanged="FormFactorCombo_SelectionChanged" />
                </StackPanel>
                <Border Grid.Row="1"
                        x:Name="CruxChartHost"
                        MinHeight="{StaticResource ReportSecondaryChartHeight}"
                        Style="{StaticResource ChartCardBorderStyle}" />
            </Grid>

            <Grid x:Name="PageSpeedPanel" Visibility="Collapsed" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        x:Name="PageSpeedChartHost"
                        MinHeight="{StaticResource ReportSecondaryChartHeight}"
                        Style="{StaticResource ChartCardBorderStyle}" />
                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.LatestRuns, Mode=OneWay}" Style="{StaticResource DataListViewStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PageSpeedLatestRun">
                                <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Strategy}" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PerformanceScoreText}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.AuditIssues, Mode=OneWay}" Style="{StaticResource DataListViewStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PageSpeedAuditIssue">
                                <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind DisplayValue}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Score}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <ListView x:Name="UrlsPanel"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind ViewModel.Urls, Mode=OneWay}"
                      Style="{StaticResource DataListViewStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PerformanceUrlInfo">
                        <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Origin}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Source}" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
