<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Numeris.Controls"
    xmlns:models="using:Numeris.Models">

    <Grid x:Name="RootGrid"
          Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Vertical" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Horizontal" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Right" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Left" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="{StaticResource PageHeaderMargin}"
                Style="{StaticResource PageHeaderBorderStyle}">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="HeaderGrid" Grid.Row="0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Health"
                               Style="{StaticResource PageTitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="HeaderControls"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <ComboBox x:Name="DomainCombo"
                                  MinWidth="176"
                                  Height="{StaticResource ToolbarControlHeight}"
                                  Style="{StaticResource DomainComboBoxStyle}"
                                  AutomationProperties.Name="Domain"
                                  SelectionChanged="DomainCombo_SelectionChanged" />
                        <Grid x:Name="ToolbarActionRow"
                              ColumnSpacing="8"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ToolbarPeriodColumn" Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:PeriodSelector x:Name="PeriodSelector"
                                                     Grid.Column="0"
                                                     SelectedPeriod="{x:Bind Shell.SelectedPeriod, Mode=OneWay}"
                                                     AutomationProperties.Name="Period"
                                                     SelectionChanged="PeriodSelector_SelectionChanged" />
                            <Button x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ToolbarRefreshButtonStyle}"
                                    Click="RefreshButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                    AutomationProperties.Name="Refresh current report"
                                    ToolTipService.ToolTip="Refresh" />
                        </Grid>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Width="20" Height="20"
                                      AutomationProperties.Name="Loading selected report"
                                      ToolTipService.ToolTip="Loading selected report; previously loaded data is still shown." />
                    </StackPanel>
                </Grid>

                <SelectorBar Grid.Row="1"
                             x:Name="TabBar"
                             Style="{StaticResource TopTabSelectorBarStyle}"
                             SelectionChanged="TabBar_SelectionChanged">
                    <SelectorBarItem Tag="uptime" Text="Uptime" />
                    <SelectorBarItem Tag="sitemap" Text="Sitemap" />
                </SelectorBar>
            </Grid>
        </Border>

        <ScrollViewer x:Name="HealthContentScrollViewer" Grid.Row="1"
                      Padding="{StaticResource PageScrollContentPadding}"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="{StaticResource ReportDataMinWidth}"
              Width="{Binding ViewportWidth, ElementName=HealthContentScrollViewer}">
            <!-- Uptime -->
            <Grid x:Name="UptimePanel" Visibility="Visible" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource ContentCardBorderStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Uptime status"
                                               Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.UptimeOverviewText, Mode=OneWay}"
                                               Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.UptimeLastCheckedText, Mode=OneWay}"
                                           Foreground="{StaticResource NumerisTextTertiaryBrush}"
                                           VerticalAlignment="Top" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Domains, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="18" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:UptimeDomainStatus">
                                        <Grid MinWidth="240" RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Domain}"
                                                           Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource ControlSurfaceBrush}"
                                                        BorderBrush="{StaticResource NumerisCardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                                        Padding="10,3">
                                                    <TextBlock Text="{x:Bind Status, Converter={StaticResource StatusTextConverter}}"
                                                               Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                                               FontSize="12" />
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Uptime (all samples)" Foreground="{StaticResource NumerisTextTertiaryBrush}" FontSize="12" />
                                                    <TextBlock Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold">
                                                        <Run Text="{x:Bind UptimePct, Converter={StaticResource OneDecimalConverter}}" />
                                                        <Run Text="%" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Failed probes" Foreground="{StaticResource NumerisTextTertiaryBrush}" FontSize="12" />
                                                    <TextBlock Text="{x:Bind Incidents}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Response" Foreground="{StaticResource NumerisTextTertiaryBrush}" FontSize="12" />
                                                    <TextBlock Text="{x:Bind ResponseMs, Converter={StaticResource MillisecondsConverter}}"
                                                               Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Top">
                            <Button Content="Check now"
                                    Click="CheckNowButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanCheckUptime, Mode=OneWay}"
                                    AutomationProperties.Name="Check uptime now"
                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUptime, Mode=OneWay}" Width="20" Height="20" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        MinHeight="{StaticResource ReportSecondaryChartHeight}"
                        Style="{StaticResource ChartCardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Average response"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.ResponseChartSummaryText, Mode=OneWay}"
                                       Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                        </Grid>
                        <Border Grid.Row="1"
                                x:Name="ResponseChartHost" />
                    </Grid>
                </Border>
                <Border Grid.Row="2"
                        MinHeight="{StaticResource ReportCompactChartHeight}"
                        Style="{StaticResource ChartCardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Failed probes"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.IncidentChartSummaryText, Mode=OneWay}"
                                       Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                        </Grid>
                        <Border Grid.Row="1"
                                x:Name="IncidentsChartHost" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Sitemap -->
            <Grid x:Name="SitemapPanel" Visibility="Collapsed" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Style="{StaticResource ContentCardBorderStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Sitemap status" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SitemapSummaryText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.SitemapLastUpdatedText, Mode=OneWay}"
                                       Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Refresh sitemap"
                                    Click="RefreshSitemapButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanRefreshSitemap, Mode=OneWay}"
                                    AutomationProperties.Name="Refresh sitemap"
                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsRefreshingSitemap, Mode=OneWay}" Width="20" Height="20" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ListView Grid.Row="1"
                          MaxHeight="{Binding ActualHeight, ElementName=HealthContentScrollViewer}"
                          ItemsSource="{x:Bind ViewModel.SitemapUrls, Mode=OneWay}"
                          Style="{StaticResource DataListViewStyle}">
                    <ListView.Header>
                        <Grid Padding="18,14,18,8" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="URL" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Last seen" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="Inspection" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SitemapUrl">
                            <Border BorderBrush="{StaticResource NumerisCardBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid Padding="18,10" MinHeight="{StaticResource TableRowHeight}" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Url}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource DataTableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind LastSeenAt, Converter={StaticResource IsoDateTimeDisplayConverter}}"
                                               Foreground="{StaticResource NumerisTextSecondaryBrush}"
                                               FontSize="12" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind IndexingStatusText}"
                                               Foreground="{StaticResource NumerisTextTertiaryBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
