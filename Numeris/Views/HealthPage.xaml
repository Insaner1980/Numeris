<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Numeris.Models">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Health" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="DomainCombo" MinWidth="160" SelectionChanged="DomainCombo_SelectionChanged" />
                <ComboBox x:Name="PeriodCombo" MinWidth="100" SelectionChanged="PeriodCombo_SelectionChanged" />
                <Button x:Name="RefreshButton" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1"
                        x:Name="TabBar"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="TabBar_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="uptime" Content="Uptime" />
                <NavigationViewItem Tag="sitemap" Content="Sitemap" />
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid Grid.Row="2">
            <!-- Uptime -->
            <Grid x:Name="UptimePanel" Visibility="Visible" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="280" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="Check now" Click="CheckNowButton_Click" Style="{ThemeResource AccentButtonStyle}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUptime, Mode=OneWay}" Width="20" Height="20" />
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Domains, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:UptimeDomainStatus">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="16"
                                    MinWidth="220">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Domain}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Status}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Uptime" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                                            <TextBlock>
                                                <Run Text="{x:Bind UptimePct, Converter={StaticResource OneDecimalConverter}}" />
                                                <Run Text="%" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Incidents" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                                            <TextBlock Text="{x:Bind Incidents}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2"
                        x:Name="ResponseChartHost"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="12" />
                <Border Grid.Row="3"
                        x:Name="IncidentsChartHost"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="12" />
            </Grid>

            <!-- Sitemap -->
            <Grid x:Name="SitemapPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Sitemap status" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SitemapSummaryText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Refresh sitemap" Click="RefreshSitemapButton_Click" Style="{ThemeResource AccentButtonStyle}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsRefreshingSitemap, Mode=OneWay}" Width="20" Height="20" />
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.SitemapUrls, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardCornerRadius}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SitemapUrl">
                            <Grid Padding="12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind LastSeenAt, FallbackValue='—'}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
