<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.GoogleAnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Numeris.Controls"
    xmlns:models="using:Numeris.Models">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          Padding="{StaticResource PagePadding}"
          RowSpacing="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Vertical" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Horizontal" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Right" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Left" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Left" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Left" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorderStyle}">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" x:Name="HeaderGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Analytics"
                               Style="{StaticResource PageTitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="HeaderControls"
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <ComboBox x:Name="DomainCombo"
                                  MinWidth="176"
                                  Height="{StaticResource ToolbarControlHeight}"
                                  Style="{StaticResource DomainComboBoxStyle}"
                                  AutomationProperties.Name="Domain"
                                  SelectionChanged="DomainCombo_SelectionChanged" />
                        <Grid x:Name="ToolbarActionRow"
                              ColumnSpacing="8"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ToolbarPeriodColumn" Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:PeriodSelector x:Name="PeriodSelector"
                                                     Grid.Column="0"
                                                     SelectedPeriod="{x:Bind Shell.SelectedPeriod, Mode=OneWay}"
                                                     AutomationProperties.Name="Period"
                                                     SelectionChanged="PeriodSelector_SelectionChanged" />
                            <Button x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ToolbarRefreshButtonStyle}"
                                    Click="RefreshButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                    AutomationProperties.Name="Refresh current report"
                                    ToolTipService.ToolTip="Refresh" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <SelectorBar Grid.Row="1"
                             x:Name="TabBar"
                             Style="{StaticResource TopTabSelectorBarStyle}"
                             SelectionChanged="TabBar_SelectionChanged">
                    <SelectorBarItem Tag="overview" Text="Overview" />
                    <SelectorBarItem Tag="pages" Text="Pages" />
                    <SelectorBarItem Tag="acquisition" Text="Acquisition" />
                    <SelectorBarItem Tag="events" Text="Events" />
                    <SelectorBarItem Tag="devices" Text="Devices" />
                </SelectorBar>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="OverviewPanel" Visibility="Visible" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Active users" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveUsersText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Sessions" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SessionsText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Page views" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PageViewsText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Engagement rate" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EngagementRateText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.EngagedSessionsText, Mode=OneWay}" Foreground="{StaticResource NumerisTextTertiaryBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1" x:Name="OverviewChartHost" Style="{StaticResource ChartCardBorderStyle}" MinHeight="{StaticResource ReportHeroChartHeight}" />
            </Grid>

            <ListView x:Name="PagesPanel"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                      Style="{StaticResource DataListViewStyle}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Style="{StaticResource DataTableHeaderBorderStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Page" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Users" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Sessions" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Views" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="Engaged sessions" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Engagement rate" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GoogleAnalyticsPageRow">
                        <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind PagePath}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ActiveUsers}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Sessions}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind PageViews}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind EngagedSessionsText}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="5" Text="{x:Bind EngagementRateText}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="AcquisitionPanel"
                    Visibility="Collapsed"
                    Style="{StaticResource ContentCardBorderStyle}">
                <controls:HorizontalBars Items="{x:Bind ViewModel.Sources, Mode=OneWay}" />
            </Border>

            <ListView x:Name="EventsPanel"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}"
                      Style="{StaticResource DataListViewStyle}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Style="{StaticResource DataTableHeaderBorderStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Event" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Count" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Key events" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GoogleAnalyticsEventRow">
                        <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind EventName}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind EventCount}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind KeyEvents}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="DevicesPanel"
                    Visibility="Collapsed"
                    Style="{StaticResource ChartCardBorderStyle}"
                    MinHeight="{StaticResource ReportSecondaryChartHeight}"
                    x:Uid="DevicesChartHost" />
        </Grid>
    </Grid>
</Page>
