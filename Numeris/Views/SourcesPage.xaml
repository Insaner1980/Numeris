<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Numeris.Models">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="Sources" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Connect live API integrations. Without configuration, mock data is used."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Cloudflare panel -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE753;" />
                        <TextBlock Text="Cloudflare" FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="0,8,0,0">
                    <TextBlock Text="Saved connections" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView ItemsSource="{x:Bind ViewModel.CloudflareConnections, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              MinHeight="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CloudflareConnectionInfo">
                                <Grid Padding="8,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Domain}" FontWeight="SemiBold" />
                                        <TextBlock>
                                            <Run Text="Zone " /><Run Text="{x:Bind ZoneId}" /><Run Text=" · status " /><Run Text="{x:Bind Status}" />
                                            <Run Text=" · last sync " /><Run Text="{x:Bind LastSync, FallbackValue='never'}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Sync"
                                            Click="SyncButton_Click"
                                            Tag="{x:Bind}" />
                                    <Button Grid.Column="2"
                                            Content="Delete"
                                            Click="DeleteButton_Click"
                                            Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1" Margin="0,4" />
                    <TextBlock Text="Add or update connection" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" Header="Domain" PlaceholderText="example.com"
                                 Text="{x:Bind ViewModel.NewCfDomain, Mode=TwoWay}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Header="Zone ID"
                                 Text="{x:Bind ViewModel.NewCfZoneId, Mode=TwoWay}" />
                        <PasswordBox Grid.Row="1" Grid.ColumnSpan="2" Header="API token"
                                     PlaceholderText="Bearer token from Cloudflare dashboard"
                                     Password="{x:Bind ViewModel.NewCfToken, Mode=TwoWay}" />
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Test"
                                    Click="TestCfButton_Click" />
                            <Button Content="Save"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="SaveCfButton_Click" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsCfBusy, Mode=OneWay}" Width="20" Height="20" />
                            <TextBlock Text="{x:Bind ViewModel.CfStatusMessage, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Web Analytics panel (placeholder) -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" />
                        <TextBlock Text="Cloudflare Web Analytics" FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <TextBlock Text="Live integration coming in next phase. Currently shows mock data."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Padding="0,8,0,0" />
            </Expander>

            <!-- Search Console panel (placeholder) -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" />
                        <TextBlock Text="Google Search Console" FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <TextBlock Text="OAuth integration coming in next phase. Currently shows mock data."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Padding="0,8,0,0" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
