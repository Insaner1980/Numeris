<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Numeris.Models">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="Sources" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Connect live API integrations. Without configuration, mock data is used."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Cloudflare panel -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE753;" />
                        <TextBlock Text="Cloudflare" FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="0,8,0,0">
                    <TextBlock Text="Saved connections" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView ItemsSource="{x:Bind ViewModel.CloudflareConnections, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              MinHeight="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CloudflareConnectionInfo">
                                <Grid Padding="8,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Domain}" FontWeight="SemiBold" />
                                        <TextBlock>
                                            <Run Text="Zone " /><Run Text="{x:Bind ZoneId}" /><Run Text=" · status " /><Run Text="{x:Bind Status}" />
                                            <Run Text=" · last sync " /><Run Text="{x:Bind LastSync, FallbackValue='never'}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Test"
                                            Click="TestSavedCfButton_Click"
                                            Tag="{x:Bind}" />
                                    <Button Grid.Column="2"
                                            Content="Sync"
                                            Click="SyncButton_Click"
                                            Tag="{x:Bind}" />
                                    <Button Grid.Column="3"
                                            Content="Delete"
                                            Click="DeleteButton_Click"
                                            Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1" Margin="0,4" />
                    <TextBlock Text="Add or update connection" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" Header="Domain" PlaceholderText="example.com"
                                 Text="{x:Bind ViewModel.NewCfDomain, Mode=TwoWay}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Header="Zone ID"
                                 Text="{x:Bind ViewModel.NewCfZoneId, Mode=TwoWay}" />
                        <PasswordBox x:Name="CfTokenBox"
                                     Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Header="API token"
                                     PlaceholderText="Bearer token from Cloudflare dashboard"
                                     Password="{x:Bind ViewModel.NewCfToken, Mode=TwoWay}" />
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Test"
                                    Click="TestCfButton_Click" />
                            <Button Content="Save"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="SaveCfButton_Click" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsCfBusy, Mode=OneWay}" Width="20" Height="20" />
                            <TextBlock Text="{x:Bind ViewModel.CfStatusMessage, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Web Analytics panel -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" />
                        <TextBlock Text="Cloudflare Web Analytics" FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="0,8,0,0">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" Header="Account ID"
                                 PlaceholderText="Cloudflare account ID"
                                 Text="{x:Bind ViewModel.NewWaAccountId, Mode=TwoWay}" />
                        <PasswordBox x:Name="WaTokenBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Header="Account Analytics token"
                                     PlaceholderText="Token for GraphQL sync"
                                     Password="{x:Bind ViewModel.NewWaToken, Mode=TwoWay}" />
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Save"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="SaveWaButton_Click" />
                            <Button Content="Test"
                                    Click="TestWaButton_Click" />
                            <Button Content="Discover sites"
                                    Click="DiscoverWaButton_Click" />
                            <Button Content="Sync"
                                    Click="SyncWaButton_Click" />
                            <Button Content="Delete" Click="DeleteWaButton_Click" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsWaBusy, Mode=OneWay}" Width="20" Height="20" />
                            <TextBlock Text="{x:Bind ViewModel.WaStatusMessage, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1" Margin="0,4" />
                    <TextBlock Text="Manual site tag mapping" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="Domain" PlaceholderText="example.com"
                                 Text="{x:Bind ViewModel.NewWaDomain, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Header="Site tag" PlaceholderText="Cloudflare Web Analytics site_tag"
                                 Text="{x:Bind ViewModel.NewWaSiteTag, Mode=TwoWay}" />
                        <Button Grid.Column="2"
                                Content="Add"
                                VerticalAlignment="Bottom"
                                Click="AddWaSiteButton_Click" />
                    </Grid>
                    <TextBlock Text="Saved sites" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.WaSites, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate xmlns:api="using:Numeris.Services.Api" x:DataType="api:WebAnalyticsSite">
                                <Grid Padding="0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Host}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SiteTag}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontFamily="Consolas" />
                                    <Button Grid.Column="2"
                                            Content="Delete"
                                            Click="DeleteWaSiteButton_Click"
                                            Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Search Console panel -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" />
                        <TextBlock Text="Google Search Console" FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="0,8,0,0">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Create a Desktop OAuth client at console.cloud.google.com → Credentials. Enable Search Console API. Add http://127.0.0.1 as authorized redirect URI." />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" Header="Client ID"
                                 PlaceholderText="xxxxx.apps.googleusercontent.com"
                                 Text="{x:Bind ViewModel.NewScClientId, Mode=TwoWay}" />
                        <PasswordBox x:Name="ScClientSecretBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Header="Client secret"
                                     Password="{x:Bind ViewModel.NewScClientSecret, Mode=TwoWay}" />
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Save"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="SaveScButton_Click" />
                            <Button Content="Connect Google account"
                                    Click="ConnectScButton_Click" />
                            <Button Content="Test"
                                    Click="TestScButton_Click" />
                            <Button Content="Sync"
                                    Click="SyncScButton_Click" />
                            <Button Content="Delete" Click="DeleteScButton_Click" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsScBusy, Mode=OneWay}" Width="20" Height="20" />
                            <TextBlock Text="{x:Bind ViewModel.ScStatusMessage, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
