<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.BingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Numeris.Models">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          Padding="{StaticResource PagePadding}"
          RowSpacing="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorderStyle}">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Bing"
                               Style="{StaticResource PageTitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="DomainCombo"
                                  MinWidth="176"
                                  Height="{StaticResource ToolbarControlHeight}"
                                  AutomationProperties.Name="Domain"
                                  SelectionChanged="DomainCombo_SelectionChanged" />
                        <ComboBox x:Name="PeriodCombo"
                                  MinWidth="120"
                                  Height="{StaticResource ToolbarControlHeight}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.Name="Period"
                                  SelectionChanged="PeriodCombo_SelectionChanged" />
                        <Button x:Name="RefreshButton"
                                Width="{StaticResource RefreshButtonSize}"
                                Height="{StaticResource RefreshButtonSize}"
                                Click="RefreshButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                AutomationProperties.Name="Refresh current report"
                                ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <SelectorBar Grid.Row="1"
                             x:Name="TabBar"
                             Style="{StaticResource TopTabSelectorBarStyle}"
                             SelectionChanged="TabBar_SelectionChanged">
                    <SelectorBarItem Tag="overview" Text="Overview" />
                    <SelectorBarItem Tag="queries" Text="Queries" />
                    <SelectorBarItem Tag="pages" Text="Pages" />
                    <SelectorBarItem Tag="crawl" Text="Crawl" />
                </SelectorBar>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="OverviewPanel" Visibility="Visible" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total clicks" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalClicksText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total impressions" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalImpressionsText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CTR" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CtrText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1" x:Name="TrafficChartHost" Style="{StaticResource ChartCardBorderStyle}" />
            </Grid>

            <Grid x:Name="QueriesPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="QuerySortCombo" Grid.Row="0" Width="180" AutomationProperties.Name="Sort queries" SelectionChanged="QuerySortCombo_SelectionChanged" />
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Queries, Mode=OneWay}"
                          Style="{StaticResource DataListViewStyle}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Style="{StaticResource DataTableHeaderBorderStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Query" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="Clicks" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="Impressions" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="CTR" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Position" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BingQueryRow">
                            <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Query}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Clicks}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Impressions}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Ctr}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind AvgImpressionPosition}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ListView x:Name="PagesPanel"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                      Style="{StaticResource DataListViewStyle}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Style="{StaticResource DataTableHeaderBorderStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Page" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Clicks" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Impressions" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="CTR" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:BingPageRow">
                        <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind PageUrl}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Clicks}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Impressions}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Ctr}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid x:Name="CrawlPanel" Visibility="Collapsed" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.CrawlSummaries, Mode=OneWay}" Style="{StaticResource DataListViewStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BingRawMethodSummary">
                            <Grid Padding="12,6" MinHeight="{StaticResource TableRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind Method}" Style="{StaticResource DataTableCellTextBlockStyle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind LastFetchedAt}" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ItemCount}" Style="{StaticResource DataTableCellTextBlockStyle}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.CrawlIssues, Mode=OneWay}" Style="{StaticResource DataListViewStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BingRawItem">
                            <Grid Padding="12,6" MinHeight="{StaticResource TableRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ItemKey}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind RawJson}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
