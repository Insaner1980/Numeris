<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.SearchConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Numeris.Controls"
    xmlns:models="using:Numeris.Models">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          Padding="{StaticResource PagePadding}"
          RowSpacing="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Vertical" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Horizontal" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Right" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Left" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Left" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Left" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorderStyle}">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" x:Name="HeaderGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Search"
                               Style="{StaticResource PageTitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="HeaderControls"
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <ComboBox x:Name="DomainCombo"
                                  MinWidth="176"
                                  Height="{StaticResource ToolbarControlHeight}"
                                  Style="{StaticResource DomainComboBoxStyle}"
                                  AutomationProperties.Name="Domain"
                                  SelectionChanged="DomainCombo_SelectionChanged" />
                        <Grid x:Name="ToolbarActionRow"
                              ColumnSpacing="8"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ToolbarPeriodColumn" Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:PeriodSelector x:Name="PeriodSelector"
                                                     Grid.Column="0"
                                                     SelectedPeriod="{x:Bind Shell.SelectedPeriod, Mode=OneWay}"
                                                     AutomationProperties.Name="Period"
                                                     SelectionChanged="PeriodSelector_SelectionChanged" />
                            <Button x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ToolbarRefreshButtonStyle}"
                                    Click="RefreshButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                    AutomationProperties.Name="Refresh current report"
                                    ToolTipService.ToolTip="Refresh" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <SelectorBar Grid.Row="1"
                             x:Name="TabBar"
                             Style="{StaticResource TopTabSelectorBarStyle}"
                             SelectionChanged="TabBar_SelectionChanged">
                    <SelectorBarItem Tag="overview" Text="Overview" />
                    <SelectorBarItem Tag="queries" Text="Queries" />
                    <SelectorBarItem Tag="pages" Text="Pages" />
                    <SelectorBarItem Tag="devices" Text="Devices" />
                    <SelectorBarItem Tag="indexing" Text="Indexing" />
                </SelectorBar>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- Overview -->
            <Grid x:Name="OverviewPanel" Visibility="Visible" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total clicks" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalClicksText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total impressions" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalImpressionsText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Avg position" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AvgPositionText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1"
                        x:Name="OverviewChartHost"
                        Style="{StaticResource ChartCardBorderStyle}"
                        MinHeight="{StaticResource ReportHeroChartHeight}" />
            </Grid>

            <!-- Queries -->
            <Grid x:Name="QueriesPanel" Visibility="Collapsed" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="QueryFilterBox" PlaceholderText="Filter queries..." Width="240" AutomationProperties.Name="Filter queries" TextChanged="QueryFilterBox_TextChanged" />
                        <ComboBox x:Name="QuerySortCombo" AutomationProperties.Name="Sort queries" SelectionChanged="QuerySortCombo_SelectionChanged" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Queries, Mode=OneWay}"
                              Style="{StaticResource DataListViewStyle}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource DataTableHeaderBorderStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Query" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="Clicks" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Impressions" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="CTR" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Position" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchQuery">
                                <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Query}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Clicks}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Impressions}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}">
                                        <Run Text="{x:Bind Ctr, Converter={StaticResource PercentConverter}, FallbackValue='0.0%'}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}">
                                        <Run Text="{x:Bind Position, Converter={StaticResource OneDecimalConverter}, FallbackValue='0.0'}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Border Grid.Column="1"
                        Style="{StaticResource ContentCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="New queries" Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Text="Queries that appeared in this period but not the previous"
                                   Foreground="{StaticResource NumerisTextTertiaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Impressions"
                                   Foreground="{StaticResource NumerisTextTertiaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Right" />
                        <ListView ItemsSource="{x:Bind ViewModel.NewQueries, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchQuery">
                                    <Grid Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Query}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Impressions}" FontWeight="SemiBold" Foreground="{StaticResource NumerisTextPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pages -->
            <Grid x:Name="PagesPanel" Visibility="Collapsed" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <ListView Grid.Column="0"
                          ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                          Style="{StaticResource DataListViewStyle}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Style="{StaticResource DataTableHeaderBorderStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Page" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="Clicks" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="Impressions" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchPageRow">
                            <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Page}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Clicks}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Impressions}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Column="1"
                        Style="{StaticResource ContentCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Declining pages" Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Text="Pages with fewer clicks than the previous period"
                                   Foreground="{StaticResource NumerisTextTertiaryBrush}"
                                   TextWrapping="Wrap" />
                        <ListView ItemsSource="{x:Bind ViewModel.DecliningPages, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DecliningPage">
                                    <Grid Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Page}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Delta}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DangerBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Devices -->
            <Border x:Name="DevicesPanel" Visibility="Collapsed"
                    Style="{StaticResource ChartCardBorderStyle}"
                    MinHeight="{StaticResource ReportSecondaryChartHeight}">
                <Border x:Name="DevicesChartHost" />
            </Border>

            <!-- Indexing -->
            <Grid x:Name="IndexingPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Style="{StaticResource ContentCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Sitemap summary" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.IndexingSummaryText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.IndexingDetailText, Mode=OneWay}"
                                       Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsInspectingIndexing, Mode=OneWay}"
                                          Width="20"
                                          Height="20" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.SitemapUrls, Mode=OneWay}"
                          Style="{StaticResource DataListViewStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SitemapUrl">
                            <Grid Padding="12,6" MinHeight="{StaticResource TableRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind IndexingStatusText}"
                                           Foreground="{StaticResource NumerisTextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind CoverageStatusText}"
                                           Foreground="{StaticResource NumerisTextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
