<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.SearchConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Numeris.Models">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Search" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="DomainCombo" MinWidth="160" SelectionChanged="DomainCombo_SelectionChanged" />
                <ComboBox x:Name="PeriodCombo" MinWidth="100" SelectionChanged="PeriodCombo_SelectionChanged" />
                <Button x:Name="RefreshButton" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1"
                        x:Name="TabBar"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="TabBar_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="overview" Content="Overview" />
                <NavigationViewItem Tag="queries" Content="Queries" />
                <NavigationViewItem Tag="pages" Content="Pages" />
                <NavigationViewItem Tag="devices" Content="Devices" />
                <NavigationViewItem Tag="indexing" Content="Indexing" />
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid Grid.Row="2">
            <!-- Overview -->
            <Grid x:Name="OverviewPanel" Visibility="Visible" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total clicks" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalClicksText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total impressions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalImpressionsText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Avg position" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AvgPositionText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1"
                        x:Name="OverviewChartHost"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="12" />
            </Grid>

            <!-- Queries -->
            <Grid x:Name="QueriesPanel" Visibility="Collapsed" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="QueryFilterBox" PlaceholderText="Filter queries..." Width="240" TextChanged="QueryFilterBox_TextChanged" />
                        <ComboBox x:Name="QuerySortCombo" SelectionChanged="QuerySortCombo_SelectionChanged" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Queries, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="{StaticResource CardCornerRadius}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Query" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Clicks" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Impressions" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="CTR" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Position" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchQuery">
                                <Grid Padding="12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Query}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Clicks}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Impressions}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right">
                                        <Run Text="{x:Bind Ctr, Converter={StaticResource PercentConverter}, FallbackValue='0.0%'}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right">
                                        <Run Text="{x:Bind Position, Converter={StaticResource OneDecimalConverter}, FallbackValue='0.0'}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="New queries" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Queries that appeared in this period but not the previous"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <ListView ItemsSource="{x:Bind ViewModel.NewQueries, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchQuery">
                                    <Grid Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Query}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Clicks}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pages -->
            <Grid x:Name="PagesPanel" Visibility="Collapsed" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <ListView Grid.Column="0"
                          ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardCornerRadius}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Page" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Clicks" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="Impressions" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchPageRow">
                            <Grid Padding="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Page}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Clicks}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Impressions}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Declining pages" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Pages with fewer clicks than the previous period"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <ListView ItemsSource="{x:Bind ViewModel.DecliningPages, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DecliningPage">
                                    <Grid Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Page}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Delta}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Devices -->
            <Border x:Name="DevicesPanel" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="12">
                <Border x:Name="DevicesChartHost" />
            </Border>

            <!-- Indexing -->
            <Grid x:Name="IndexingPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Indexing summary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.IndexingSummaryText, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.SitemapUrls, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardCornerRadius}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SitemapUrl">
                            <Grid Padding="12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Verdict, FallbackValue='—'}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind CoverageState, FallbackValue='—'}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
