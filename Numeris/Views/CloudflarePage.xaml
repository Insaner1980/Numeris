<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.CloudflarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Numeris.Controls"
    xmlns:models="using:Numeris.Models">

    <Grid x:Name="RootGrid"
          Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Vertical" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="*" />
                        <Setter Target="TrafficListsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="TopPagesCard.(Grid.Row)" Value="1" />
                        <Setter Target="TopPagesCard.(Grid.Column)" Value="0" />
                        <Setter Target="WaListsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="WaPagesCard.(Grid.Row)" Value="1" />
                        <Setter Target="WaPagesCard.(Grid.Column)" Value="0" />
                        <Setter Target="WaCountriesCard.(Grid.Row)" Value="2" />
                        <Setter Target="WaCountriesCard.(Grid.Column)" Value="0" />
                        <Setter Target="StatusServerErrorsKpi.(Grid.Row)" Value="1" />
                        <Setter Target="StatusServerErrorsKpi.(Grid.Column)" Value="0" />
                        <Setter Target="StatusTopIssueCard.(Grid.Row)" Value="1" />
                        <Setter Target="StatusTopIssueCard.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControls.Orientation" Value="Horizontal" />
                        <Setter Target="HeaderControls.(Grid.Row)" Value="0" />
                        <Setter Target="HeaderControls.(Grid.Column)" Value="1" />
                        <Setter Target="HeaderControls.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="HeaderControls.HorizontalAlignment" Value="Right" />
                        <Setter Target="DomainCombo.HorizontalAlignment" Value="Left" />
                        <Setter Target="PeriodSelector.HorizontalAlignment" Value="Left" />
                        <Setter Target="ToolbarActionRow.HorizontalAlignment" Value="Left" />
                        <Setter Target="ToolbarPeriodColumn.Width" Value="Auto" />
                        <Setter Target="TrafficListsGrid.ColumnSpacing" Value="16" />
                        <Setter Target="TopPagesCard.(Grid.Row)" Value="0" />
                        <Setter Target="TopPagesCard.(Grid.Column)" Value="1" />
                        <Setter Target="WaListsGrid.ColumnSpacing" Value="16" />
                        <Setter Target="WaPagesCard.(Grid.Row)" Value="0" />
                        <Setter Target="WaPagesCard.(Grid.Column)" Value="1" />
                        <Setter Target="WaCountriesCard.(Grid.Row)" Value="0" />
                        <Setter Target="WaCountriesCard.(Grid.Column)" Value="2" />
                        <Setter Target="StatusServerErrorsKpi.(Grid.Row)" Value="0" />
                        <Setter Target="StatusServerErrorsKpi.(Grid.Column)" Value="2" />
                        <Setter Target="StatusTopIssueCard.(Grid.Row)" Value="0" />
                        <Setter Target="StatusTopIssueCard.(Grid.Column)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="{StaticResource PageHeaderMargin}"
                Style="{StaticResource PageHeaderBorderStyle}">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" x:Name="HeaderGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Cloudflare"
                               Style="{StaticResource PageTitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="HeaderControls"
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <ComboBox x:Name="DomainCombo"
                                  MinWidth="176"
                                  Height="{StaticResource ToolbarControlHeight}"
                                  Style="{StaticResource DomainComboBoxStyle}"
                                  AutomationProperties.Name="Domain"
                                  SelectionChanged="DomainCombo_SelectionChanged" />
                        <Grid x:Name="ToolbarActionRow"
                              ColumnSpacing="8"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ToolbarPeriodColumn" Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:PeriodSelector x:Name="PeriodSelector"
                                                     Grid.Column="0"
                                                     SelectedPeriod="{x:Bind Shell.SelectedPeriod, Mode=OneWay}"
                                                     AutomationProperties.Name="Period"
                                                     SelectionChanged="PeriodSelector_SelectionChanged" />
                            <Button x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ToolbarRefreshButtonStyle}"
                                    Click="RefreshButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                    AutomationProperties.Name="Refresh current report"
                                    ToolTipService.ToolTip="Refresh" />
                        </Grid>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Width="20" Height="20"
                                      AutomationProperties.Name="Loading selected report"
                                      ToolTipService.ToolTip="Loading selected report; previously loaded data is still shown." />
                    </StackPanel>
                </Grid>

                <SelectorBar Grid.Row="1"
                             x:Name="TabBar"
                             Style="{StaticResource TopTabSelectorBarStyle}"
                             SelectionChanged="TabBar_SelectionChanged">
                    <SelectorBarItem Tag="traffic" Text="Traffic" />
                    <SelectorBarItem Tag="cache" Text="Cache" />
                    <SelectorBarItem Tag="security" Text="Security" />
                    <SelectorBarItem Tag="status" Text="Status codes" />
                    <SelectorBarItem Tag="webanalytics" Text="Web Analytics" />
                </SelectorBar>
                <InfoBar Grid.Row="2"
                         IsOpen="{x:Bind ViewModel.HasRefreshStatusMessage, Mode=OneWay}"
                         Message="{x:Bind ViewModel.RefreshStatusMessage, Mode=OneWay}"
                         Severity="{x:Bind ViewModel.RefreshSeverity, Mode=OneWay}"
                         IsClosable="False"
                         Style="{StaticResource StatusInfoBarStyle}"
                         AutomationProperties.Name="Cloudflare refresh status" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="PageScrollViewer"
                      Padding="{StaticResource PageScrollContentPadding}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Traffic -->
                <Grid x:Name="TrafficPanel" Visibility="Visible" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            x:Name="TrafficChartHost"
                            Style="{StaticResource ChartCardBorderStyle}"
                            MinHeight="{StaticResource ReportHeroChartHeight}" />
                    <Grid Grid.Row="1"
                          x:Name="TrafficListsGrid"
                          ColumnSpacing="16"
                          RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                x:Name="TopCountriesCard"
                                Style="{StaticResource ContentCardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Top countries"
                                           Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <controls:HorizontalBars x:Name="TrafficCountryBars"
                                                         Items="{x:Bind ViewModel.TrafficCountries, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                x:Name="TopPagesCard"
                                Style="{StaticResource ContentCardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Top pages"
                                           Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <controls:HorizontalBars Items="{x:Bind ViewModel.TrafficPages, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Cache -->
                <Grid x:Name="CachePanel" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Style="{StaticResource ContentCardBorderStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Average hit ratio"
                                           Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CacheHitRatioText, Mode=OneWay}"
                                           Style="{ThemeResource SubtitleTextBlockStyle}"
                                           Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Style="{StaticResource ContentCardBorderStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Bandwidth saved"
                                           Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CacheBytesSavedText, Mode=OneWay}"
                                           Style="{ThemeResource SubtitleTextBlockStyle}"
                                           Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1"
                            x:Name="CacheChartHost"
                            Style="{StaticResource ChartCardBorderStyle}"
                            MinHeight="{StaticResource ReportHeroChartHeight}" />
                </Grid>

                <!-- Security -->
                <Grid x:Name="SecurityPanel" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total threats blocked"
                                       Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalThreatsText, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       Foreground="{StaticResource NumerisTextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1"
                            x:Name="SecurityChartHost"
                            Style="{StaticResource ChartCardBorderStyle}"
                            MinHeight="{StaticResource ReportHeroChartHeight}" />
                </Grid>

                <!-- Status codes -->
                <Grid x:Name="StatusPanel" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="StatusMetricsGrid" Style="{StaticResource ResponsiveKpiGridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:KpiCard x:Name="StatusSuccessRateKpi"
                                          Grid.Column="0"
                                          Label="Success rate"
                                          Detail="2xx responses"
                                          Value="{x:Bind ViewModel.StatusSuccessRateText, Mode=OneWay}" />
                        <controls:KpiCard x:Name="StatusClientErrorsKpi"
                                          Grid.Column="1"
                                          Label="Client errors"
                                          Detail="4xx responses"
                                          Value="{x:Bind ViewModel.StatusClientErrorsText, Mode=OneWay}" />
                        <controls:KpiCard x:Name="StatusServerErrorsKpi"
                                          Grid.Column="2"
                                          Label="Server / edge errors"
                                          Detail="5xx responses"
                                          Value="{x:Bind ViewModel.StatusServerErrorsText, Mode=OneWay}" />
                        <Border x:Name="StatusTopIssueCard"
                                Grid.Column="3"
                                Style="{StaticResource ContentCardBorderStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Top issue"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontFamily="{StaticResource NumerisFontFamily}"
                                           FontSize="13"
                                           Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.StatusTopIssueText, Mode=OneWay}"
                                           Style="{StaticResource SectionTitleTextBlockStyle}"
                                           TextWrapping="WrapWholeWords"
                                           MaxLines="2" />
                                <TextBlock Text="Largest 4xx/5xx code"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontFamily="{StaticResource NumerisFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource ChartCardBorderStyle}"
                            MinHeight="{StaticResource ReportHeroChartHeight}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="HTTP responses by status group"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <Border Grid.Row="1"
                                    x:Name="StatusChartHost" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Top status codes"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.StatusTopCodes, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatusCodeIssueRow">
                                        <Grid MinHeight="{StaticResource TableRowHeight}" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Code}"
                                                       Style="{StaticResource DataTableCellTextBlockStyle}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Description}"
                                                       Style="{StaticResource DataTableCellTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind RequestsText}"
                                                       Style="{StaticResource DataTableCellTextBlockStyle}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind ShareText}"
                                                       Style="{StaticResource DataTableCellTextBlockStyle}"
                                                       Foreground="{StaticResource NumerisTextTertiaryBrush}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Web Analytics -->
                <Grid x:Name="WaPanel" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            x:Name="WaChartHost"
                            Style="{StaticResource ChartCardBorderStyle}"
                            MinHeight="{StaticResource ReportHeroChartHeight}" />
                    <Grid Grid.Row="1" x:Name="WaListsGrid" ColumnSpacing="16" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Style="{StaticResource ContentCardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Top referrers"
                                           Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <controls:HorizontalBars Items="{x:Bind ViewModel.WaReferrers, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                x:Name="WaPagesCard"
                                Style="{StaticResource ContentCardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Top pages"
                                           Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <controls:HorizontalBars Items="{x:Bind ViewModel.WaPages, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                x:Name="WaCountriesCard"
                                Style="{StaticResource ContentCardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Top countries"
                                           Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <controls:HorizontalBars Items="{x:Bind ViewModel.WaCountries, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
