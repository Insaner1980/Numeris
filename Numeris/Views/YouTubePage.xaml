<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Numeris.Views.YouTubePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Numeris.Controls"
    xmlns:models="using:Numeris.Models">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          Padding="{StaticResource PagePadding}"
          RowSpacing="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorderStyle}">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="YouTube"
                                   Style="{StaticResource PageTitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ChannelTitle, Mode=OneWay}"
                                   Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="PeriodCombo"
                                  MinWidth="120"
                                  Height="{StaticResource ToolbarControlHeight}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.Name="Period"
                                  SelectionChanged="PeriodCombo_SelectionChanged" />
                        <Button x:Name="RefreshButton"
                                Width="{StaticResource RefreshButtonSize}"
                                Height="{StaticResource RefreshButtonSize}"
                                Click="RefreshButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                AutomationProperties.Name="Refresh current report"
                                ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <SelectorBar Grid.Row="1"
                             x:Name="TabBar"
                             Style="{StaticResource TopTabSelectorBarStyle}"
                             SelectionChanged="TabBar_SelectionChanged">
                    <SelectorBarItem Tag="overview" Text="Overview" />
                    <SelectorBarItem Tag="videos" Text="Videos" />
                    <SelectorBarItem Tag="geography" Text="Geography" />
                    <SelectorBarItem Tag="traffic" Text="Traffic" />
                    <SelectorBarItem Tag="devices" Text="Devices" />
                    <SelectorBarItem Tag="retention" Text="Retention" />
                </SelectorBar>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="OverviewPanel" Visibility="Visible" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Views" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ViewsText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Watch time" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.WatchTimeText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Avg duration" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AverageDurationText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ContentCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Subscribers net" Foreground="{StaticResource NumerisTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SubscribersNetText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{StaticResource NumerisTextPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1" x:Name="DailyChartHost" Style="{StaticResource ChartCardBorderStyle}" />
            </Grid>

            <ListView x:Name="VideosPanel"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                      Style="{StaticResource DataListViewStyle}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Style="{StaticResource DataTableHeaderBorderStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Video" Style="{StaticResource DataTableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Views" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Watch min" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Avg %" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="Likes" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Comments" Style="{StaticResource DataTableHeaderTextBlockStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:YouTubeVideoStat">
                        <Grid Padding="12,4" MinHeight="{StaticResource TableRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Views}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind EstimatedMinutesWatched}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind AverageViewPercentage}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Likes}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Comments}" HorizontalAlignment="Right" Style="{StaticResource DataTableCellTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="GeographyPanel" Visibility="Collapsed" Style="{StaticResource ContentCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Geography" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <controls:HorizontalBars Items="{x:Bind ViewModel.Countries, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border x:Name="TrafficPanel" Visibility="Collapsed" Style="{StaticResource ContentCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Traffic sources" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <controls:HorizontalBars Items="{x:Bind ViewModel.TrafficSources, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border x:Name="DevicesPanel" Visibility="Collapsed" Style="{StaticResource ContentCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Devices" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <controls:HorizontalBars Items="{x:Bind ViewModel.Devices, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Grid x:Name="RetentionPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="RetentionVideoCombo"
                          Grid.Row="0"
                          Width="360"
                          DisplayMemberPath="Title"
                          AutomationProperties.Name="Retention video"
                          SelectionChanged="RetentionVideoCombo_SelectionChanged" />
                <Border Grid.Row="1" x:Name="RetentionChartHost" Style="{StaticResource ChartCardBorderStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
