<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Numeris.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Numeris"
    xmlns:converters="using:Numeris.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:PercentConverter x:Key="PercentConverter" />
            <converters:OneDecimalConverter x:Key="OneDecimalConverter" />
            <converters:IsoDateTimeDisplayConverter x:Key="IsoDateTimeDisplayConverter" />
            <converters:StatusTextConverter x:Key="StatusTextConverter" />
            <converters:EmptyFallbackConverter x:Key="EmptyFallbackConverter" />
            <converters:MillisecondsConverter x:Key="MillisecondsConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
