<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Numeris.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Numeris"
    xmlns:views="using:Numeris.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Numeris">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        CompactPaneLength="64"
                        OpenPaneLength="220"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard" Content="Overview">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20"
                                   Height="20"
                                   Source="ms-appx:///Assets/Icons/overview-filled.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="cloudflare" Content="Cloudflare">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20"
                                   Height="20"
                                   Source="ms-appx:///Assets/Icons/cloudflare-filled.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="search" Content="Google Search">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20"
                                   Height="20"
                                   Source="ms-appx:///Assets/Icons/google-search-filled.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="bing" Content="Bing">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20"
                                   Height="20"
                                   Source="ms-appx:///Assets/Icons/bing-filled.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="performance" Content="Performance">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20"
                                   Height="20"
                                   Source="ms-appx:///Assets/Icons/performance-filled.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="health" Content="Health">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20"
                                   Height="20"
                                   Source="ms-appx:///Assets/Icons/health-filled.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="sources" Content="Sources">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20"
                                   Height="20"
                                   Source="ms-appx:///Assets/Icons/sources-filled.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <InfoBar IsOpen="{x:Bind _shell.HasSettingsError, Mode=OneWay}"
                             Message="{x:Bind _shell.SettingsErrorMessage, Mode=OneWay}"
                             Severity="Warning"
                             IsClosable="False" />
                    <InfoBar x:Name="LegacyImportInfoBar"
                             IsOpen="{x:Bind _shell.HasLegacyImportError, Mode=OneWay}"
                             Message="{x:Bind _shell.LegacyImportErrorMessage, Mode=OneWay}"
                             Severity="Warning" />
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="{StaticResource AppTitleBarHeight}"
              Padding="{StaticResource AppTitleBarPadding}"
              Background="Transparent">
            <TextBlock Text="Numeris"
                       Style="{StaticResource AppTitleTextBlockStyle}" />
        </Grid>
    </Grid>
</Window>
