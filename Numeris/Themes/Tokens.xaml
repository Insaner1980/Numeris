<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>

    <Thickness x:Key="PagePadding">24,16,24,24</Thickness>
    <Thickness x:Key="CardPadding">20,16,20,16</Thickness>

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>

    <!-- Accent (warm gold from Pulse, retained as brand color) -->
    <Color x:Key="NumerisAccentColor">#D9A24E</Color>
    <SolidColorBrush x:Key="NumerisAccentBrush" Color="{StaticResource NumerisAccentColor}" />

    <Color x:Key="NumerisChartGridColor">#15FFFFFF</Color>
    <SolidColorBrush x:Key="NumerisChartGridBrush" Color="{StaticResource NumerisChartGridColor}" />

    <!-- Tone palette for KPI cards (overridden by system theme on light mode) -->
    <Color x:Key="ToneAColor">#D9A24E</Color>
    <Color x:Key="ToneBColor">#92EBD8</Color>
    <Color x:Key="ToneCColor">#84A98C</Color>
    <Color x:Key="ToneDColor">#C97B6A</Color>

</ResourceDictionary>
