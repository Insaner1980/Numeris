<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Numeris.Controls.KpiCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Numeris.Controls">

    <Grid x:Name="MetricContent"
          Style="{StaticResource KpiCardSurfaceStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind Label, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   FontFamily="{StaticResource NumerisFontFamily}"
                   FontSize="13"
                   Foreground="{StaticResource NumerisTextTertiaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1" />

        <Grid Grid.Row="1"
              ColumnSpacing="{StaticResource Space2}"
              Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{x:Bind Value, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       FontFamily="{StaticResource NumerisFontFamily}"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource NumerisTextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       VerticalAlignment="Center" />

            <controls:DeltaBadge Grid.Column="1"
                                 Value="{x:Bind ChangeValue, Mode=OneWay}"
                                 Suffix="%"
                                 ShowSign="True"
                                 Visibility="{x:Bind ShowChange, Mode=OneWay}"
                                 ToolTipService.ToolTip="{x:Bind ChangeTooltip, Mode=OneWay}"
                                 AutomationProperties.Name="{x:Bind ChangeTooltip, Mode=OneWay}"
                                 VerticalAlignment="Center" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{x:Bind Detail, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   FontFamily="{StaticResource NumerisFontFamily}"
                   FontSize="12"
                   Foreground="{StaticResource NumerisTextTertiaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,4,0,0" />
    </Grid>
</UserControl>
