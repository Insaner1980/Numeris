<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Numeris.Controls.PeriodSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Period">

    <Border x:Name="SelectorSurface"
            Background="{StaticResource ControlSurfaceBrush}"
            BorderBrush="{StaticResource NumerisCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PeriodSelectorCornerRadius}"
            Padding="{StaticResource PeriodSelectorPadding}"
            MinWidth="{StaticResource PeriodSelectorMinWidth}"
            MinHeight="{StaticResource ToolbarControlHeight}">
        <Grid ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="Last7Button"
                    Grid.Column="0"
                    Style="{StaticResource PeriodSelectorSegmentButtonStyle}"
                    Click="Last7Button_Click" />
            <Button x:Name="Last30Button"
                    Grid.Column="1"
                    Style="{StaticResource PeriodSelectorSegmentButtonStyle}"
                    Click="Last30Button_Click" />
            <Button x:Name="Last90Button"
                    Grid.Column="2"
                    Style="{StaticResource PeriodSelectorSegmentButtonStyle}"
                    Click="Last90Button_Click" />
            <Button x:Name="AllButton"
                    Grid.Column="3"
                    Style="{StaticResource PeriodSelectorSegmentButtonStyle}"
                    Click="AllButton_Click" />
        </Grid>
    </Border>
</UserControl>
