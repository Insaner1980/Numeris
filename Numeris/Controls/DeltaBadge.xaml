<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Numeris.Controls.DeltaBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="{StaticResource DeltaBadgePadding}"
            CornerRadius="{StaticResource DeltaBadgeCornerRadius}"
            Background="{StaticResource ControlSurfaceBrush}"
            BorderBrush="{StaticResource NumerisCardBorderBrush}"
            BorderThickness="1"
            MinHeight="24">
        <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}"
                   Foreground="{x:Bind DeltaBrush, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   FontFamily="{StaticResource NumerisFontFamily}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1" />
    </Border>
</UserControl>
